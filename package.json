{
  "name": "commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal home for small apps and utilities",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
